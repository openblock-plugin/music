{
  "name": "music",
  "version": "0.1.0",
  "author": "Scratch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openblock-plugin/music.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "gen-manifest": "node scripts/generate-manifest.cjs",
    "dev": "npm run gen-manifest && npx openblock-registry-cli dev",
    "build": "npm run gen-manifest && npx openblock-registry-cli build",
    "build:obfuscate": "npm run gen-manifest && npx openblock-registry-cli build --obfuscate",
    "publish": "npx openblock-registry-cli publish",
    "publish:dry": "npx openblock-registry-cli publish --dry-run",
    "validate": "npx openblock-registry-cli validate",
    "i18n:update": "npx openblock-registry-cli i18n update",
    "lint": "eslint . --ext .js --fix"
  },
  "openblock": {
    "name": {
      "formatMessage": {
        "id": "music.name",
        "default": "Music"
      }
    },
    "extensionId": "music",
    "arch": [
      "*"
    ],
    "programMode": [
      "realtime"
    ],
    "iconURL": "./assets/music.png",
    "description": {
      "formatMessage": {
        "id": "music.description",
        "default": "Play instruments and drums."
      }
    },
    "internetConnectionRequired": false,
    "main": "./src/music.js",
    "translations": "./src/translations.js",
    "tags": [
      "scratch"
    ],
    "helpLink": "https://wiki.openblock.cc"
  },
  "devDependencies": {
    "eslint": "^5.3.0",
    "eslint-config-scratch": "^5.0.0",
    "husky": "^9.0.0"
  }
}
